@echo off
cd /d "%~dp0"
echo === img-gen ===
echo starting api server (port 8765)...
start /min cmd /c "python src\server.py > server.log 2>&1"

echo waiting for server...
set /a tries=0
:waitloop
timeout /t 1 /nobreak >nul
curl -s -o nul http://127.0.0.1:8765/api/health
if errorlevel 1 (
  set /a tries+=1
  if %tries% lss 20 goto waitloop
  echo.
  echo ERROR: server did not start. See server.log:
  type server.log
  pause
  exit /b 1
)

echo opening browser...
start "" "http://127.0.0.1:8765/ui.html"
echo done. (server runs minimized; close it or run taskkill /f /im python.exe to stop)
pause
