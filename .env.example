# =============================================================================
# Prompt Studio — environment
#
# Local:      copy to .env and fill in.
# Vercel:     Project → Settings → Environment Variables, and add each name below
#             there. This file is the template and the documentation; no real value
#             is ever committed.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. REQUIRED — encryption for stored provider keys
# -----------------------------------------------------------------------------
# A Fernet key (44 chars) or any passphrase; a passphrase is stretched with PBKDF2.
# Without it in production the app refuses to start, because credentials could not be
# encrypted at rest. Generate one:
#
#     python -m app.cli init-key
#
# Changing this after credentials are stored makes them unreadable — each key would
# have to be re-entered. Keep it safe.
APP_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# 2. REQUIRED ON VERCEL — durable storage
# -----------------------------------------------------------------------------
# Vercel's filesystem is per-instance and wiped between requests, so SQLite on disk
# cannot be the database and uploads cannot live on disk. Both are required for a
# deployment; locally they are optional and SQLite + ./uploads are used instead.
#
# DATABASE_URL   any Postgres connection string. Vercel Postgres, Neon, Supabase and
#                Railway all work. After adding it, run the migrations once:
#                    python -m app.cli migrate
# BLOB_READ_WRITE_TOKEN
#                from a Vercel Blob store (Storage → Create → Blob). Without it,
#                generated files would be written to a disk that disappears, and the
#                app reports that instead of losing them quietly.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# -----------------------------------------------------------------------------
# 3. Server
# -----------------------------------------------------------------------------
APP_ENV=production
PUBLIC_APP_URL=https://your-project.vercel.app
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8765

# -----------------------------------------------------------------------------
# 4. Limits
# -----------------------------------------------------------------------------
MAX_FILE_SIZE=52428800
MAX_JSON_BODY=2097152
UPSTREAM_TIMEOUT=120
MAX_JOB_ATTEMPTS=3
JOB_TIMEOUT=600
JOB_WORKERS=2
# How long one invocation's claim on a job stays valid. A job whose worker disappears
# becomes available again after this, so nothing is stuck forever.
JOB_LEASE_SECONDS=300
# The cron tick's budget in seconds. Keep it below the function's maxDuration so the
# tick finishes and writes its result instead of being killed mid-job.
TICK_BUDGET_SECONDS=8

# -----------------------------------------------------------------------------
# 5. Development only
# -----------------------------------------------------------------------------
# 1 lets you connect to a model server on localhost, and DISABLES the SSRF guard.
# Never set this in production.
# ALLOW_PRIVATE_UPSTREAM=

# =============================================================================
# 6. MODELS — one section per model, with its key and model name
# =============================================================================
#
# Every model below is one Higgsfield offers. For each, set:
#
#   <PREFIX>_API_KEY    your key for the provider that serves it
#   <PREFIX>_MODEL      the model id to send (pre-filled with the documented one; set
#                       it only if your gateway names it differently)
#   <PREFIX>_BASE_URL   only when the provider is not OpenAI or Google
#   <PREFIX>_ENABLED    set to 0 to keep a model configured but hidden
#
# A model with no key stays hidden rather than appearing and failing when clicked.
# Check what is live with:  GET /api/catalog
#
# NOTE ON PROVIDERS
#   Higgsfield has no public API, so none of these is called through Higgsfield itself.
#   Each model is served by the provider listed, and that is whose key you need. The
#   model ids are the documented ones.
#
#   OpenAI  → base URL is built in  (https://api.openai.com/v1)
#   Google  → base URL is built in  (generativelanguage.googleapis.com, OpenAI-compatible path)
#   fal.ai  → set <PREFIX>_BASE_URL to https://fal.run
#             fal reaches models by path, so <PREFIX>_MODEL holds the model path.

# -----------------------------------------------------------------------------
# 6a. IMAGE
# -----------------------------------------------------------------------------

# Nano Banana Pro — Gemini 3 Pro Image (Google)
NANO_BANANA_PRO_API_KEY=
NANO_BANANA_PRO_MODEL=gemini-3-pro-image-preview
# NANO_BANANA_PRO_BASE_URL=

# Nano Banana — Gemini 2.5 Flash Image (Google)
NANO_BANANA_API_KEY=
NANO_BANANA_MODEL=gemini-2.5-flash-image
# NANO_BANANA_BASE_URL=

# Seedream 4 (ByteDance, via fal.ai)
SEEDREAM_4_API_KEY=
SEEDREAM_4_MODEL=fal-ai/bytedance/seedream/v4/text-to-image
# SEEDREAM_4_BASE_URL=https://fal.run

# FLUX 2 Pro (Black Forest Labs, via fal.ai)
FLUX_2_PRO_API_KEY=
FLUX_2_PRO_MODEL=fal-ai/flux-2-pro
# FLUX_2_PRO_BASE_URL=https://fal.run

# FLUX Kontext Pro — editing (Black Forest Labs, via fal.ai)
FLUX_KONTEXT_PRO_API_KEY=
FLUX_KONTEXT_PRO_MODEL=fal-ai/flux-pro/kontext
# FLUX_KONTEXT_PRO_BASE_URL=https://fal.run

# GPT Image 1 (OpenAI)
GPT_IMAGE_API_KEY=
GPT_IMAGE_MODEL=gpt-image-1
# GPT_IMAGE_BASE_URL=

# Ideogram v3 (via fal.ai)
IDEOGRAM_V3_API_KEY=
IDEOGRAM_V3_MODEL=fal-ai/ideogram/v3
# IDEOGRAM_V3_BASE_URL=https://fal.run

# Qwen Image (Alibaba, via fal.ai)
QWEN_IMAGE_API_KEY=
QWEN_IMAGE_MODEL=fal-ai/qwen-image
# QWEN_IMAGE_BASE_URL=https://fal.run

# Recraft v3 (via fal.ai)
RECRAFT_V3_API_KEY=
RECRAFT_V3_MODEL=fal-ai/recraft/v3/text-to-image
# RECRAFT_V3_BASE_URL=https://fal.run

# Soul — Higgsfield's own model. No public API: leave unconfigured unless you have a
# gateway that serves it, in which case set the base URL to that gateway.
SOUL_API_KEY=
SOUL_MODEL=
# SOUL_BASE_URL=

# -----------------------------------------------------------------------------
