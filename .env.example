# Copy to .env and fill in. This file is the only place configuration belongs.
# Never commit .env itself.

# --- required in production ------------------------------------------------
# A Fernet key (44 chars) or any passphrase; a passphrase is stretched with PBKDF2.
# Generate one with:  python -m app.cli init-key
APP_ENCRYPTION_KEY=

# --- environment -----------------------------------------------------------
# development relaxes two safety rails: it generates a throwaway encryption key if
# none is set, and it can allow private upstream addresses. production refuses both.
APP_ENV=development

# --- server ----------------------------------------------------------------
HOST=127.0.0.1
PORT=8765
PUBLIC_APP_URL=http://127.0.0.1:8765
LOG_LEVEL=INFO

# --- storage ---------------------------------------------------------------
# Where the SQLite database and uploaded media live. Both default to ./data and
# ./uploads relative to the project root.
# DATA_DIR=
# UPLOAD_DIR=

# --- limits ----------------------------------------------------------------
MAX_FILE_SIZE=52428800
MAX_JSON_BODY=2097152
UPSTREAM_TIMEOUT=120
MAX_JOB_ATTEMPTS=3
JOB_WORKERS=2
JOB_TIMEOUT=600

# --- development only ------------------------------------------------------
# 1 allows connections to private/loopback addresses, so a model server on
# localhost can be used. Leave unset in production: it disables the SSRF guard.
# ALLOW_PRIVATE_UPSTREAM=

# --- provider credentials --------------------------------------------------
# There are deliberately NO provider keys here. This app is BYOK: each connection
# stores its own encrypted key, entered by the user in the UI, so the server never
# needs a shared credential of its own.
