# LTX_2_BASE_URL=https://fal.run

# -----------------------------------------------------------------------------
# 6c. UTILITY
# -----------------------------------------------------------------------------

# Topaz video upscale (via fal.ai)
TOPAZ_UPSCALE_API_KEY=
TOPAZ_UPSCALE_MODEL=fal-ai/topaz/upscale/video
# TOPAZ_UPSCALE_BASE_URL=https://fal.run

# -----------------------------------------------------------------------------
# 6d. Users can still add their own
# -----------------------------------------------------------------------------
# The connections UI stays available: a user can add any OpenAI-compatible URL, key and
# model id that is not in this list. The catalogue is what an operator pre-fills, not a
# restriction on what the app can reach.
