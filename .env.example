KLING_2_5_TURBO_MODEL=fal-ai/kling-video/v2.5-turbo/pro/text-to-video
# KLING_2_5_TURBO_BASE_URL=https://fal.run

# Sora 2 (OpenAI)
SORA_2_API_KEY=
SORA_2_MODEL=sora-2
# SORA_2_BASE_URL=

# Sora 2 Pro (OpenAI)
SORA_2_PRO_API_KEY=
SORA_2_PRO_MODEL=sora-2-pro
# SORA_2_PRO_BASE_URL=

# Veo 3 Fast (Google, via fal.ai)
VEO_3_FAST_API_KEY=
VEO_3_FAST_MODEL=fal-ai/veo3/fast
# VEO_3_FAST_BASE_URL=https://fal.run

# Veo 3 (Google, via fal.ai)
VEO_3_API_KEY=
VEO_3_MODEL=fal-ai/veo3
# VEO_3_BASE_URL=https://fal.run

# Seedance 1.0 Pro (ByteDance, via fal.ai)
SEEDANCE_1_PRO_API_KEY=
SEEDANCE_1_PRO_MODEL=fal-ai/bytedance/seedance/v1/pro/text-to-video
# SEEDANCE_1_PRO_BASE_URL=https://fal.run

# Hailuo 02 (MiniMax, via fal.ai)
HAILUO_02_API_KEY=
HAILUO_02_MODEL=fal-ai/minimax/hailuo-02/standard/text-to-video
# HAILUO_02_BASE_URL=https://fal.run

# Wan 2.5 (Alibaba, via fal.ai)
WAN_2_5_API_KEY=
WAN_2_5_MODEL=fal-ai/wan-25-preview/text-to-video
# WAN_2_5_BASE_URL=https://fal.run

# LTX-2 (Lightricks, via fal.ai)
LTX_2_API_KEY=
